  "panelDiscussion": {
    "title": "Panel: Big Model Adaptation for Computer Vision",
    "time": "June 2026 (TBD)",
    "description": "This panel brings together the invited speakers to discuss current challenges and future opportunities in adapting large pretrained models for computer vision. Topics will include post-pretraining strategies, prompting techniques, and the role of vision models in multimodal systems.",
